# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/minorfm?sslmode=disable

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080
# Comma-separated production origins (no trailing slash)
ALLOWED_ORIGINS=https://minor.fm,https://www.minor.fm
# Used in password-reset email links
APP_URL=https://minor.fm

# ── Cloudflare R2 (media uploads) ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=minorfm
R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev

# ── Resend (transactional emails — password reset etc.) ─────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "From" address — must be a verified domain in Resend dashboard
RESEND_FROM=MINOR.fm <noreply@minor.fm>
