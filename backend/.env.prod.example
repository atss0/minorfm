# --- TEMEL AYARLAR ---
APP_URL=https://minor.fm
PORT=8080
ALLOWED_ORIGINS=https://minor.fm

# Üretmek için: openssl rand -hex 32
JWT_SECRET=BURAYA_GUCLU_SECRET_GIR

# --- VERİTABANI & REDIS ---
# DATABASE_URL compose tarafından override edilir, buradaki değer kullanılmaz
DATABASE_URL=postgres://postgres:BURAYA_DB_SIFRESI@postgres:5432/minorfm?sslmode=disable
POSTGRES_PASSWORD=BURAYA_DB_SIFRESI
REDIS_URL=redis://redis:6379

# --- CLOUDFLARE R2 (Dosya Depolama) ---
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=minorfm
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- RESEND (E-posta Gönderimi) ---
RESEND_API_KEY=
RESEND_FROM=MINOR.fm <noreply@minor.fm>
